# Copy to .env (git-ignored) and fill in. Test values only while testing.

# Stripe (Dashboard → Developers → API keys, sandbox/test mode)
STRIPE_SECRET_KEY=sk_test_...
# Locally: printed by `stripe listen --forward-to localhost:3000/api/stripe-webhook`
# Deployed: the signing secret of the webhook endpoint in Stripe
STRIPE_WEBHOOK_SECRET=whsec_...

# Lulu sandbox (developers.sandbox.lulu.com → API Keys); add LULU_ENV=production only with live keys
LULU_KEY=
LULU_SECRET=
# LULU_ENV=production

# Vercel Blob (added automatically on Vercel; copy it here for local runs)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Local only
SITE_URL=http://localhost:3000
CHROME_PATH="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"

# Any long random string (openssl rand -hex 24), for POST /api/print/retry
ADMIN_TOKEN=

# Optional
# PRINT_MARGIN_USD=0
# PRINT_BUFFER=0.04
# STRIPE_TAX=1
# PRINT_CONTACT_EMAIL=you@example.com
# RPC_URL=https://base-sepolia-rpc.publicnode.com
